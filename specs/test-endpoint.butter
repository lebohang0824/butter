app TestEndpoint
  description "Example endpoint."
  version "1.0.0"

endpoint ProcessOrder "/api/checkout/orders"
  description "Validates checkout items, processes the transaction, and generates an order summary invoice."
  version "1.0.0"
  method POST

  params
    checkout_token string
    coupon_code string
    dry_run boolean

  responses
    InvoiceLineItem
      sku string
      description string
      unit_price double
      quantity integer
    OrderSuccessPayload
      order_id string
      total_amount double
      currency string
      line_items array[string]

  actions
    "Verify checkout token is valid and active"
    "Calculate final prices using coupon_code"
    "Authorize payment transaction via external provider"
    "Commit transaction details and reserve inventory"

  returns
    201 OrderSuccessPayload
    200 OrderSuccessPayload
    400 "Invalid or expired checkout token"
    402 "Payment authorization failed"
    500 "External payment provider connection times out"
