# TodoApp — A complete task management application
# AI agents: implement every feature below. Each feature's actions are sequential
# execution steps — run them one after another in the listed order. Respect all
# types and constraints.

app TodoApp
  description "A full-featured todo application with task management capabilities. This spec demonstrates Butter's AI intent workflow: an AI agent reads the compiled prompt and produces a complete working application with higher first-pass accuracy."
  version "1.0.0"

feature CreateTask
  description "Allows creation of new tasks with title, priority, and due date. AI agents: this feature's actions are sequential — validate, then assign ID, then timestamp, then notify and schedule."
  version "1.0.0"

  params
    title string
    description string
    completed boolean
    priority enum["low", "medium", "high", "urgent"]
    due_date string

  actions
    "Validate title is not empty"
    "Assign unique identifier to the new task"
    "Set creation timestamp to current time"
    "Set completed status to false"
    "Send notification to assigned user"
    "Schedule reminder for due date"

feature ListTasks
  description "Retrieves and filters tasks based on various criteria; each task provides an Edit button that opens a modal for update and delete operations. AI agents: query first, then sort, then validate limits, then limit, then paginate — sequential, never parallel."
  version "1.0.0"

  params
    status_filter enum["all", "pending", "completed", "archived"]
    sort_by enum["created", "priority", "due_date", "title"]
    limit integer

  actions
    "Query task repository with specified filters"
    "Sort results according to sort_by parameter"
    "Limit results to specified count"
    "Apply pagination metadata to response"

feature UpdateTask
  description "Modifies existing task attributes via a modal form opened from the task list. AI agents: look up, pre-fill form, merge changes, timestamp, reject-archived check — each step is one discrete operation."
  version "1.0.0"
  # When rendering the update form, pre-fill each field with the task's current
  # values so the user can see what they are changing before modifying them.

  params
    task_id string
    title string
    status enum["pending", "completed", "archived"]
    priority enum["low", "medium", "high", "urgent"]

  actions
    "Look up task by task_id"
    "Populate form fields with current task values for reference"
    "Merge provided fields into existing task record"
    "Set last-modified timestamp to current time"
    "Reject update if task is archived"

feature DeleteTask
  description "Removes a task from the system permanently via a confirmation modal. AI agents: verify existence, verify confirmation matches title, remove, broadcast — strictly sequential."
  version "1.0.0"

  params
    task_id string
    confirmation string

  actions
    "Verify task_id exists in repository"
    "Verify confirmation matches task title"
    "Remove task record from persistent storage"
    "Broadcast deletion event to connected clients"
