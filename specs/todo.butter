# TodoApp — A task management application intent specification
# AI agents: implement the application behavior below. Each feature's actions
# are sequential execution steps — run them one after another in the listed order.
# Respect all types, rules, and constraints.
app TodoApp
  description "A task management application for creating, listing, updating, and deleting tasks."
  version "1.0.0"

  rules
    "Users may only access tasks they own"
    "A task cannot be completed until it is assigned to a user"
    "Operations that would create duplicate tasks must be rejected"
    "Archived tasks cannot be modified or deleted"

feature CreateTask
  description "Creates a task with a title, priority, and optional due date."
  version "1.0.0"

  params
    title string
    description string
    completed boolean
    priority enum["low", "medium", "high", "urgent"]
    due_date string

  actions
    "Validate title is not empty"
    "Assign unique identifier to the new task"
    "Set creation timestamp to current time"
    "Set completed status to false"
    "Send notification to assigned user"
    "Schedule reminder for due date"

feature ListTasks
  description "Retrieves and filters tasks based on the requesting user's criteria."
  version "1.0.0"

  params
    status_filter enum["all", "pending", "completed", "archived"]
    sort_by enum["created", "priority", "due_date", "title"]
    limit integer

  actions
    "Select tasks owned by the requesting user"
    "Sort results according to sort_by parameter"
    "Limit results to specified count"
    "Apply pagination metadata to response"

feature UpdateTask
  description "Updates editable attributes of a task."

  params
    task_id string
    title string
    status enum["pending", "completed", "archived"]
    priority enum["low", "medium", "high", "urgent"]

  actions
    "Look up the task owned by the requesting user"
    "Reject the update if the task is archived"
    "Validate title is not empty when provided"
    "Apply the requested task changes"
    "Set the last-modified timestamp"

feature DeleteTask
  description "Permanently removes a task after confirmation."
  version "1.0.0"

  params
    task_id string
    confirmation string

  actions
    "Look up the task owned by the requesting user"
    "Verify confirmation matches the task title"
    "Reject the deletion if the task is archived"
    "Remove the task"
    "Notify authorized observers about the deletion"
