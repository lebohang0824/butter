# Butter VS Code Extension Documentation
app ButterExtension
  description "VS Code extension providing syntax highlighting, IntelliSense, formatting, linting, and language configuration for Butter, an intent specification language for AI agents."
  version "2.1.0"

feature SyntaxHighlighting
  description "TextMate grammar providing tokenization and named capture highlighting for .butter files."
  version "2.1.0"

  params
    scope_name string
    language_id string

  actions
    "Highlight comment lines starting with # using comment.line.number-sign.butter scope"
    "Highlight app declarations with keyword and entity.name.type captures"
    "Highlight feature declarations with keyword and entity.name.function captures"
    "Highlight bare param lines (name type) with variable.parameter and support.type captures"
    "Highlight keywords: app, description, version, feature, rules, params, actions, responses, method, returns"
    "Highlight double-quoted string literals with string.quoted.double scope"
    "Highlight boolean constants: true, false"
    "Highlight endpoint name and route string with entity.name.function and string.quoted.double captures"
    "Highlight method lines with a quoted HTTP verb (such as method POST) via keyword and support.constant.http-method captures"
    "Highlight response headers (PascalCase name) with entity.name.class captures"
    "Highlight returns lines (status code + payload) with constant.numeric.integer and entity.name.class captures"

feature LanguageConfiguration
  description "Editor configuration for indentation, bracket matching, auto-closing pairs, and comment toggling."
  version "2.1.0"

  params
    line_comment string
    increase_indent_pattern string
    decrease_indent_pattern string

  actions
    "Configure # as line comment token for comment toggle and block commenting"
    "Configure square brackets as matching bracket pairs"
    "Configure auto-closing pairs for double-quote strings and square brackets"
    "Set indentation rules: increase indent on feature, endpoint, params, actions, responses, rules, returns declarations"
    "Set indentation rules: decrease indent on blank lines and dedented content"

feature LintingEngine
  description "On-save and on-open linting that runs butter compile --check and surfaces errors as diagnostics."
  version "2.1.0"

  params
    compiler_path string
    lint_on_open boolean
    lint_on_save boolean

  actions
    "Lint document on open: execute butter compile --check against the file"
    "Lint document on save: execute butter compile --check against the file"
    "Parse compiler stderr output for line-prefixed error messages using regex"
    "Surface errors as VS Code diagnostics with red squiggly underlines at the affected line"
    "Clear diagnostics when the file passes all checks"
    "Provide Butter: Lint current file command in the command palette"
    "Respect configurable compiler binary path via butter.compilerPath setting"

feature FormattingEngine
  description "On-save formatting that runs butter fmt and applies edits to the document."
  version "2.1.0"

  params
    format_on_save boolean
    temp_dir string

  actions
    "Format document on save: execute butter fmt on a temporary copy of the file"
    "Write unformatted content to temp file before invoking the compiler"
    "Read formatted output from temp file after compiler finishes"
    "Replace full document text with formatted content using WorkspaceEdit"
    "Re-save the document after applying formatting edits"
    "Skip lint pass when formatting changes were applied to avoid redundant checks"
    "Provide Butter: Format current file command in the command palette"
    "Fall back to lint-only when formatting fails or produces no changes"

feature CompileOnSave
  description "Optional on-save compilation that writes selected output formats next to the source spec."
  version "2.1.0"

  params
    compile_on_save boolean
    compile_formats array[string]

  actions
    "Compile the document on save when butter.compileOnSave is enabled"
    "Generate each output format selected in butter.compileFormats"
    "Write generated files next to the source spec using the compiler's default output naming"
    "Log compile results and failures in the Butter output channel"
