{
  "comments": {
    "lineComment": "#",
    "alternativeLineComment": "//"
  },
  "brackets": [
    ["[", "]"]
  ],
  "autoClosingPairs": [
    {"open": "\"", "close": "\""},
    {"open": "[", "close": "]"}
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(feature|endpoint|params|actions|responses|returns|rules)\\b.*$",
    "decreaseIndentPattern": "^\\s*$"
  }
}
