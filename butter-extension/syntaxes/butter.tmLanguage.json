{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Butter DSL Language Configuration Map",
  "scopeName": "source.butter",
  "patterns": [
    { "include": "#comments" },
    { "include": "#app_name" },
    { "include": "#feature_name" },
    { "include": "#endpoint_name_route" },
    { "include": "#endpoint_name" },
    { "include": "#method_line" },
    { "include": "#bare_param" },
    { "include": "#enum_type" },
    { "include": "#array_type" },
    { "include": "#response_header" },
    { "include": "#enforce_line" },
    { "include": "#returns_line" },
    { "include": "#status_codes" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "match": "(#|//).*$",
      "name": "comment.line.number-sign.butter"
    },
    "app_name": {
      "match": "\\b(app)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.control.butter" },
        "2": { "name": "entity.name.type.butter" }
      }
    },
    "feature_name": {
      "match": "\\b(feature)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.control.butter" },
        "2": { "name": "entity.name.function.butter" }
      }
    },
    "endpoint_name_route": {
      "match": "\\b(endpoint)\\s+([A-Za-z_]\\w*)\\s+(\"[^\"]*\")",
      "captures": {
        "1": { "name": "keyword.control.butter" },
        "2": { "name": "entity.name.function.butter" },
        "3": { "name": "string.quoted.double.butter" }
      }
    },
    "endpoint_name": {
      "match": "\\b(endpoint)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "keyword.control.butter" },
        "2": { "name": "entity.name.function.butter" }
      }
    },
    "method_line": {
      "match": "\\b(method)\\s+([A-Z]+)\\b",
      "captures": {
        "1": { "name": "keyword.control.butter" },
        "2": { "name": "support.constant.http-method.butter" }
      }
    },
    "bare_param": {
      "match": "^\\s+([A-Za-z_]\\w*)\\s+(string|integer|double|boolean|enum\\[.*?\\]|array\\[.*?\\]|\\w+)\\s*$",
      "captures": {
        "1": { "name": "variable.parameter.butter" },
        "2": { "name": "support.type.butter" }
      }
    },
    "enum_type": {
      "match": "\\b(enum)\\[([^\\]]+)\\]",
      "captures": {
        "1": { "name": "support.type.butter" },
        "2": { "name": "string.quoted.double.butter" }
      }
    },
    "array_type": {
      "match": "\\b(array)\\[(string|integer|double|boolean|\\w+)\\]",
      "captures": {
        "1": { "name": "support.type.butter" },
        "2": { "name": "entity.name.class.butter" }
      }
    },
    "response_header": {
      "match": "^\\s+([A-Z][A-Za-z0-9_]*)\\s*$",
      "captures": {
        "1": { "name": "entity.name.class.butter" }
      }
    },
    "enforce_line": {
      "match": "^\\s+(enforce)\\s+(\"[^\"]*\")",
      "captures": {
        "1": { "name": "keyword.control.butter" },
        "2": { "name": "string.quoted.double.butter" }
      }
    },
    "returns_line": {
      "match": "^\\s+(returns)\\s*$",
      "name": "keyword.control.butter"
    },
    "status_codes": {
      "match": "^\\s+(\\d{3})\\s+(?:([A-Za-z_]\\w*))?",
      "captures": {
        "1": { "name": "constant.numeric.integer.butter" },
        "2": { "name": "entity.name.class.butter" }
      }
    },
    "keywords": {
      "match": "\\b(app|description|version|feature|endpoint|rules|params|actions|responses|method|returns|enforce)\\b",
      "name": "keyword.control.butter"
    },
    "strings": {
      "name": "string.quoted.double.butter",
      "begin": "\"",
      "end": "\""
    },
    "constants": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.butter"
    }
  }
}
